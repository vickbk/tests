{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "types": ["node"]
  },
  "include": [
    "src/index.ts",
    "src/shared/**/*.ts",
    "src/features/vitest/index.ts",
    "src/features/vitest/readme-contract.ts",
