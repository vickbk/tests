{
  "name": "@vickbk/tests",
  "version": "0.1.0",
  "description": "Testing helpers for Vitest and Playwright.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vickbk/tests.git"
  },
  "author": "Vick Bake <vickbake8@gmail.com>",
  "keywords": [
    "testing",
    "vitest",
    "playwright",
    "utilities",
    "helpers"
  ],
  "bugs": {
    "url": "https://github.com/vickbk/tests/issues"
  },
  "homepage": "https://github.com/vickbk/tests#readme",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vitest": {
      "import": {
        "types": "./dist/vitest.d.mts",
        "default": "./dist/vitest.mjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./playwright": {
      "import": {
        "types": "./dist/playwright.d.mts",
        "default": "./dist/playwright.mjs"
      },
      "require": {
        "types": "./dist/playwright.d.cts",
        "default": "./dist/playwright.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.package.json",
    "test": "vitest",
    "lint": "eslint",
    "prepublishOnly": "pnpm typecheck && pnpm build",
    "release-note": "tsx ./src/bin/extract-release-note.ts",
    "release-tag": "tsx ./src/bin/extract-version-tag.ts",
    "test-comment": "tsx ./src/bin/post-vitest-coverage.ts",
    "coverage-summary": "tsx ./src/bin/coverage-summary.ts",
    "readme-check": "tsx ./src/bin/documentation/readme-check",
    "readme-comment": "tsx ./src/bin/documentation/post-readme-comment"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.0.0 || ^19.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "vitest": "^5.0.5"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "@testing-library/jest-dom": {
      "optional": true
    },
    "@testing-library/react": {
      "optional": true
    },
    "@testing-library/user-event": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vickbk/ci-tools": "^0.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "jsdom": "^30.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
